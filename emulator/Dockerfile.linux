# Builds the Linux emulator that goes in the AppImage. A binary runs on its own glibc or a newer one, so
# this stays on an old release, the oldest with a new enough compiler. MAME needs GCC 11.
FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates git python3 \
    libfontconfig-dev libgl-dev libpcap-dev libsdl2-dev libsdl2-ttf-dev \
    libx11-dev libxext-dev libxi-dev libxinerama-dev
# Docker Desktop reports a folder made inside a mount as root's, and git refuses to use a repository like that
RUN git config --system --add safe.directory '*'
# Builds ffmpeg's fast paths. It's on its own line so adding it didn't rebuild what's above
RUN apt-get update && apt-get install -y --no-install-recommends nasm
