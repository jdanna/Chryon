{
  "name": "maxine-font-studio",
  "version": "0.1.0",
  "description": "Convert TTF/OTF fonts to Chyron MAXINE machine fonts and upload them to the unit",
  "main": "./out/main/index.js",
  "author": "Joey D'Anna",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:headless": "electron-vite build && node scripts/headless/driver.mjs",
    "download-python": "node scripts/download-python.mjs",
    "predist:mac": "node scripts/download-python.mjs darwin arm64 && node scripts/download-python.mjs darwin x64 && node scripts/vendor-python-packages.mjs darwin arm64 && node scripts/vendor-python-packages.mjs darwin x64",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "predist:mac-signed": "npm run predist:mac",
    "dist:mac-signed": "node scripts/dist-mac-signed.js",
    "predist:win": "node scripts/download-python.mjs win32 x64 && node scripts/vendor-python-packages.mjs win32 x64",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:win-signed": "node scripts/dist-win-signed.js",
    "predist:win-ci": "npm run predist:win",
    "dist:win-ci": "electron-vite build && electron-builder --win --config electron-builder.win-signed.js",
    "predist:linux": "node scripts/download-python.mjs linux x64 && node scripts/vendor-python-packages.mjs linux x64",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "release": "node scripts/release.mjs",
    "release-signed": "node scripts/release.mjs --signed"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/lib-storage": "^3.1092.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "extract-zip": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
